{
  "name": "@voidix/database",
  "version": "0.0.0",
  "private": true,
  "//type": "ESM, because the seeder resolves the repo root from import.meta.url — unavailable once tsx transforms this to CJS.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "verify": "tsx src/scripts/verify.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@voidix/content": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
